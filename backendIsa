@app.post("/consultas")
def criar_consulta():
    data = request.get_json(force=True)
    id_paciente = data.get("id_paciente")
    id_medico = data.get("id_medico")
    data_consulta = data.get("data_consulta")
    hora_consulta = data.get("hora_consulta")
    descricao = data.get("descricao")
    status = data.get("status", "Agendada")

    if not all([id_paciente, id_medico, data_consulta, hora_consulta]):
        return jsonify({"error": "Campos obrigatórios: id_paciente, id_medico, data_consulta e hora_consulta"}), 400

    with SessionLocal() as session:
        nova = Consultas(
            id_paciente=id_paciente,
            id_medico=id_medico,
            data_consulta=data_consulta,
            hora_consulta=hora_consulta,
            descricao=descricao,
            status=status
        )
        session.add(nova)
        session.commit()
        session.refresh(nova)

    return jsonify({
        "id": nova.id,
        "id_paciente": nova.id_paciente,
        "id_medico": nova.id_medico,
        "data_consulta": str(nova.data_consulta),
        "hora_consulta": str(nova.hora_consulta),
        "descricao": nova.descricao,
        "status": nova.status
    }), 201

