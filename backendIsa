@app.get("/medicos")
def listar_medicos():
    with SessionLocal() as session:
        medicos = session.query(Medicos).all()
        dados = [
            {"id": m.id, "nome": m.nome, "especialidade": m.especialidade,
             "telefone": m.telefone, "email": m.email}
